{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lesley:teaching-pack-builder:starter-input:0.1",
  "title": "Teaching Pack Builder pilot input",
  "description": "Draft structural contract for the existing Starter subject-be adapter only. Not a universal unit schema or content approval.",
  "type": "object",
  "properties": {
    "manifest": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "unit_id": {
          "const": "hanlin7a-starter-subject-be"
        },
        "title": {
          "const": "Starter Unit｜主格代名詞與 be 動詞"
        },
        "policy_authority": {
          "const": "LESLEY_TEACHING_ENGINE_v2.4_STABLE.md"
        },
        "content_authority": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "original_complete": {
              "type": "boolean"
            },
            "official_edition_confirmed": {
              "type": "boolean"
            },
            "teacher_confirmed_current_source": {
              "type": "boolean"
            },
            "source_readiness": {
              "enum": [
                "READY",
                "READY_WITH_LIMITS",
                "BLOCKED"
              ]
            },
            "source_limits": {
              "type": "string",
              "minLength": 1
            },
            "source_items_answer_exposed": {
              "type": "boolean"
            },
            "source_files_are_committed": {
              "type": "boolean"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "file_page_1_indexed": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "printed_page": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "section": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "ref",
                  "file",
                  "file_page_1_indexed",
                  "printed_page",
                  "section"
                ]
              }
            }
          },
          "required": [
            "kind",
            "original_complete",
            "official_edition_confirmed",
            "teacher_confirmed_current_source",
            "source_readiness",
            "source_limits",
            "source_items_answer_exposed",
            "source_files_are_committed",
            "sources"
          ]
        },
        "content_source_lock": {
          "type": "object",
          "properties": {
            "in_scope": {
              "const": "主格代名詞與 am/is/are 的肯定直述句搭配；用已見名字構成新的短句。"
            },
            "out_of_scope": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "lexical_allowlist": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "verified_prior_exposure_for_particular_student": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "in_scope",
            "out_of_scope",
            "lexical_allowlist",
            "verified_prior_exposure_for_particular_student"
          ]
        },
        "pedagogy_lock": {
          "type": "object",
          "properties": {
            "learning_target": {
              "const": "辨識主詞並在新的直述句中正確選擇 am/is/are。"
            },
            "cognitive_action": {
              "type": "string",
              "minLength": 1
            },
            "evidence_types": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "scaffolds": {
              "type": "string",
              "minLength": 1
            },
            "support_removal_point": {
              "type": "string",
              "minLength": 1
            },
            "parallel_recheck": {
              "type": "string",
              "minLength": 1
            },
            "transfer": {
              "type": "string",
              "minLength": 1
            },
            "delayed_plan": {
              "type": "string",
              "minLength": 1
            },
            "route": {
              "type": "string",
              "minLength": 1
            },
            "formal_gate_approved": {
              "type": "boolean"
            },
            "formal_release_authorized": {
              "type": "boolean"
            }
          },
          "required": [
            "learning_target",
            "cognitive_action",
            "evidence_types",
            "scaffolds",
            "support_removal_point",
            "parallel_recheck",
            "transfer",
            "delayed_plan",
            "route",
            "formal_gate_approved",
            "formal_release_authorized"
          ]
        },
        "publication": {
          "type": "object",
          "properties": {
            "status": {
              "const": "DRAFT_FOR_TEACHER_REVIEW"
            },
            "release_quality_review": {
              "type": "string",
              "minLength": 1
            },
            "classroom_validated": {
              "type": "boolean"
            },
            "teacher_approved": {
              "type": "boolean"
            }
          },
          "required": [
            "status",
            "release_quality_review",
            "classroom_validated",
            "teacher_approved"
          ]
        }
      },
      "required": [
        "schema",
        "unit_id",
        "title",
        "policy_authority",
        "content_authority",
        "content_source_lock",
        "pedagogy_lock",
        "publication"
      ]
    },
    "item_map": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "unit_id": {
          "const": "hanlin7a-starter-subject-be"
        },
        "instructions": {
          "type": "object",
          "properties": {
            "guided": {
              "type": "string",
              "minLength": 1
            },
            "independent": {
              "type": "string",
              "minLength": 1
            },
            "transfer": {
              "type": "string",
              "minLength": 1
            },
            "delayed": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "guided",
            "independent",
            "transfer",
            "delayed"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[GITD][0-9]{2}$"
              },
              "stage": {
                "enum": [
                  "guided",
                  "independent",
                  "transfer",
                  "delayed"
                ]
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "answers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "target": {
                "enum": [
                  "pronoun-be",
                  "pronoun-perspective-and-be"
                ]
              },
              "construct": {
                "type": "string",
                "minLength": 1
              },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "cognitive_level": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "diagnosis": {
                "type": "string",
                "minLength": 1
              },
              "leakage": {
                "type": "string",
                "minLength": 1
              },
              "context_zh": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "stage",
              "prompt",
              "answers",
              "target",
              "construct",
              "source_refs",
              "cognitive_level",
              "rationale",
              "diagnosis",
              "leakage"
            ]
          }
        }
      },
      "required": [
        "schema",
        "unit_id",
        "instructions",
        "items"
      ]
    }
  },
  "required": [
    "manifest",
    "item_map"
  ],
  "additionalProperties": false
}
